@startuml
left to right direction
skinparam linetype ortho

skinparam nodesep 50
skinparam ranksep 70
skinparam usecase {
  BackgroundColor #f0f8ff
  BorderColor #333
  FontSize 14
}

actor "Гость" as Guest <<Person>>
actor "Пользователь" as AuthUser <<Person>>
actor "Бизнес" as Business <<Person>>

rectangle "Система otvet.mail.ru" {
  usecase (UC-02 Создать вопрос) as UC2
  usecase (UC-03 Создать опрос) as UC3
  usecase (UC-06 Поиск вопросов) as UC6
  usecase (UC-07 Рейтинги) as UC7
  usecase (UC-05 Навигация по категориям) as UC5
  usecase (UC-01 Авторизация) as UC1
  usecase (UC-04 Регистрация компании) as UC4

  UC1 .> UC2 : <<include>>
  UC1 .> UC4 : <<include>>
  UC1 .> UC3 : <<include>>
  UC1 .> UC7 : <<include>>
}

Guest --> UC5
Guest --> UC6

note top of UC5
  <b>Проверяемые категории:</b>
  ───────────────────
  Домашние задания
  Авто, Мото
  Программирование
  (20+ разделов)
end note

AuthUser --> UC2
AuthUser --> UC3
AuthUser --> UC1

note bottom of UC3
  <b>Параметры опроса:</b>
  1. 4 варианта ответа
  2. Множественный выбор
  3. Настройки доступа
end note

AuthUser --> UC7
Business --> UC4
Business --> UC1

note right of UC1
  <b>Обязателен для:</b>
  • Создания контента
  • Бизнес-регистрации
  • Анализа рейтингов
end note

@enduml
